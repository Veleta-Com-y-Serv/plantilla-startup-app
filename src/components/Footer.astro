---
// Pie a todo el ancho en tinta: marca y redes, menú, contacto y aviso legal desde site.yaml, con el nombre
// gigante en degradado al final (decorativo). «Web creada con NoExpertise» si site.yaml → marca_pie es true.
import { site, tel, mapa, whatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'app' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor grid gap-12 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan text-lg">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-lista">
        {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
        {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp</a></li>}
        {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
        {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
        {c.horario && <li>{c.horario}</li>}
      </ul>
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  <div class="contenedor" aria-hidden="true">
    <p class="pie-marca-gigante">{site.nombre}</p>
  </div>
</footer>
