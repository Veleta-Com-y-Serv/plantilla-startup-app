---
// Cómo se empieza: banda clara con los pasos en línea (4 columnas en escritorio, en vertical en móvil), unidos
// por una línea en degradado, con número grande en monoespaciada e icono. Campos: `items[]` (titulo, texto, icono).
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const pasos = s ? s.items.filter((i) => i && i.titulo) : [];
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-clara">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {pasos.length > 0 && (
          <ol class:list={['pasos relative grid gap-10 md:grid-cols-2 md:gap-x-10', { 'lg:grid-cols-4': pasos.length >= 4, 'lg:grid-cols-3': pasos.length === 3 }]}>
            {pasos.map((p, i) => (
              <li class="paso relative pl-20 lg:pl-0 lg:pt-24">
                <span class="paso-marca absolute top-0 left-0 grid h-14 w-14 place-items-center rounded-full bg-fondo">
                  <span class="icono-caja h-14 w-14 rounded-full"><Icono nombre={p.icono} tam={24} /></span>
                </span>
                <span class="mono degradado-texto text-5xl font-bold md:text-6xl">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 text-2xl md:text-3xl">{p.titulo}</h3>
                {p.texto && <p class="mt-3 max-w-xs opacity-70">{p.texto}</p>}
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )
}

<style>
  .pasos::before { content: ""; position: absolute; left: 1.75rem; top: 1rem; bottom: 1rem; width: 2px; background: var(--degradado); opacity: 0.35; }
  @media (min-width: 768px) { .pasos::before { display: none; } }
  @media (min-width: 1024px) {
    .pasos::before { display: block; left: 1.75rem; right: 0; top: 1.75rem; bottom: auto; width: auto; height: 2px; }
  }
</style>
