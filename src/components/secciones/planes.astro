---
// Planes: banda suave con los planes en columnas pegadas que llenan todo el ancho del contenido (en móvil, una
// debajo de otra). El plan `destacado` va en degradado con la etiqueta `etiqueta_destacado`. Sin precio no se
// pinta precio; `incluye` es una cadena separada por «;». Botón de cada plan: `cta_texto` (o el de `cta`) y
// destino `cta.url` (o el formulario). Campos: planes[] (nombre, precio, periodo, texto, incluye, destacado,
// cta_texto), etiqueta_destacado, nota, cta.
import { seccion, valores, campo } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const planes = s ? s.planes.filter((p) => p && p.nombre) : [];
const etiqueta = campo(s?.etiqueta_destacado);
const nota = campo(s?.nota);
const destino = s?.cta?.url || '#contacto';
const columnas = planes.length >= 4 ? 'lg:grid-cols-4' : planes.length === 3 ? 'lg:grid-cols-3' : planes.length === 2 ? 'md:grid-cols-2' : '';
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-suave">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {planes.length > 0 && (
          <ul class:list={['planes grid overflow-hidden rounded-[var(--radio)]', columnas]}>
            {planes.map((p) => {
              const incluye = valores(p.incluye);
              const boton = campo(p.cta_texto) || campo(s.cta?.texto);
              return (
                <li class:list={['plan flex flex-col p-7 md:p-10', p.destacado ? 'plan--destacado banda-degradado' : 'bg-fondo']}>
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <h3 class="text-2xl md:text-3xl">{p.nombre}</h3>
                    {p.destacado && etiqueta && <span class="mono rounded-full bg-white/20 px-3 py-1 text-xs font-semibold tracking-wide uppercase">{etiqueta}</span>}
                  </div>
                  {p.texto && <p class="mt-3 opacity-75">{p.texto}</p>}
                  {p.precio && (
                    <p class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="plan-precio">{p.precio}</span>
                      {p.periodo && <span class="mono text-sm opacity-75">{p.periodo}</span>}
                    </p>
                  )}
                  {!p.precio && p.periodo && <p class="mono mt-8 text-sm opacity-75">{p.periodo}</p>}
                  {incluye.length > 0 && (
                    <ul class="mt-8 grid gap-3 border-t border-current/15 pt-8">
                      {incluye.map((v) => (
                        <li class="flex gap-3"><Icono nombre="check" tam={20} class:list={['mt-0.5 shrink-0', p.destacado ? '' : 'text-primario']} />{v}</li>
                      ))}
                    </ul>
                  )}
                  {boton && (
                    <div class="mt-auto pt-10">
                      <a class:list={['w-full sm:w-auto', p.destacado ? 'btn btn-blanco' : 'btn']} href={destino}>{boton}</a>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )}
        {nota && <p class="mono mt-8 text-sm opacity-70">{nota}</p>}
      </div>
    </section>
  )
}

<style>
  .planes { gap: 1px; background: var(--linea); border: 1px solid var(--linea); }
  .plan-precio { font-family: var(--fuente-titulos); font-weight: 900; letter-spacing: -0.05em; line-height: 1; font-size: clamp(2.75rem, 5vw, 4rem); }
</style>
