---
// Funciones: banda clara a todo el ancho; titular partido (título a la izquierda, texto a la derecha) y rejilla
// 3×2 de celdas separadas por líneas finas (sin tarjetas), cada una con su icono en degradado.
// Campos: `items[]` (titulo, texto, icono, detalle). Sin items solo se ve el titular. Las funciones con `detalle`
// tienen página propia (/funciones/<slug>/) y la celda entera enlaza a ella; las demás quedan como texto.
import { seccion } from '../../data/site';
import Icono from '../ui/Icono.astro';
import { enlaceDe } from '../../lib/paginas';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((i) => i && i.titulo) : [];
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-clara">
      <div class="contenedor">
        <div class="mb-12 grid gap-6 md:mb-16 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
          <div>
            {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
            {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          </div>
          {s.texto && <p class="text-lg opacity-75 md:text-xl">{s.texto}</p>}
        </div>
        {items.length > 0 && (
          <ul class="funciones-rejilla grid sm:grid-cols-2 lg:grid-cols-3">
            {items.map((it, i) => (
              <li class="funcion group relative py-8 sm:p-7 md:p-10">
                <span class="mono absolute top-8 right-0 text-xs opacity-40 sm:top-7 sm:right-7 md:top-10 md:right-10">{String(i + 1).padStart(2, '0')}</span>
                <span class="icono-caja"><Icono nombre={it.icono} tam={26} /></span>
                <h3 class="mt-8 text-2xl md:text-[1.7rem]">{enlaceDe(it) ? <a href={enlaceDe(it)} class="funcion-enlace">{it.titulo}</a> : it.titulo}</h3>
                {it.texto && <p class="mt-3 max-w-sm opacity-70">{it.texto}</p>}
                {enlaceDe(it) && <span class="funcion-ver mono" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .funciones-rejilla { border-top: 1px solid var(--linea); }
  .funcion { border-bottom: 1px solid var(--linea); transition: background-color 0.2s ease; }
  .funcion-enlace { text-decoration: none; color: inherit; }
  .funcion-enlace::after { content: ""; position: absolute; inset: 0; }
  .funcion-enlace:focus-visible { outline: none; }
  .funcion:has(.funcion-enlace:focus-visible) { outline: 2px solid var(--c-primario); outline-offset: -2px; }
  .funcion-ver { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1.25rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 700; color: var(--c-primario); }
  .funcion:hover { background: var(--suave); }
  @media (min-width: 640px) {
    .funcion:nth-child(odd) { border-right: 1px solid var(--linea); }
  }
  @media (min-width: 1024px) {
    .funcion:nth-child(odd) { border-right: 0; }
    .funcion:not(:nth-child(3n)) { border-right: 1px solid var(--linea); }
  }
</style>
