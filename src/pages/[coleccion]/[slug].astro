---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /funciones/<slug>/.
// Diseño «página de producto»: banda en degradado con rejilla fina (migas, título enorme en blanco, texto corto,
// precio y botones; a la derecha la foto con esquinas de 1,5 rem o, sin foto, el icono en un cuadro blanco);
// banda clara con el `detalle` y, al lado, la tabla de datos y la caja de contacto en tinta; galería en banda suave;
// y otras funciones de la misma lista en banda tinta. La cabecera fija queda sólida (no hay hero debajo).
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = seccion('contacto') ? enlace('/#contacto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Pruébala gratis';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-degradado ficha-cabeza relative overflow-hidden">
    <div class="rejilla-fondo pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="contenedor relative">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="ficha-titulo">{f.titulo}</h1>
          {f.texto && <p class="ficha-intro">{f.texto}</p>}
          {f.precio && <p class="ficha-chips"><span class="ficha-precio mono">{f.precio}</span></p>}
          <div class="ficha-botones">
            <a class="btn btn-blanco" href={contacto}>{textoContacto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span class="icono-caja"><Icono nombre={f.icono || 'rayo'} tam={72} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion banda-clara">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo mono">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio-dato">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda-tinta">
          <p class="ficha-cita-titulo">¿La probamos con tu equipo?</p>
          <p class="opacity-80">Empieza cuando quieras, sin tarjeta y sin permanencia.</p>
          <a class="btn" href={contacto}>{textoContacto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="seccion banda-suave" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion banda-tinta">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras funciones" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="icono-caja"><Icono nombre={o.icono || 'rayo'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                <span class="ficha-otra-ver mono" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todas las funciones</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-top: calc(var(--alto-cabecera) + 1rem); padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .85rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .6; }
  .migas a { color: #fff; opacity: .85; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; opacity: 1; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: center; }
  .ficha-titulo { margin-top: 1rem; font-size: clamp(2.4rem, 7vw, 5.2rem); font-weight: 900; letter-spacing: -0.045em; line-height: .98; overflow-wrap: anywhere; }
  .ficha-intro { margin-top: 1.25rem; font-size: 1.2rem; max-width: 38rem; opacity: .9; }
  .ficha-chips { margin-top: 1.5rem; }
  .ficha-precio { display: inline-block; padding: .35rem .9rem; border-radius: 999px; border: 1.5px solid rgb(255 255 255 / .5); font-weight: 700; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 3rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; box-shadow: 0 30px 60px -30px rgb(0 0 0 / .6); outline: 1px solid rgb(255 255 255 / .3); outline-offset: 8px; }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--radio); border: 1px solid rgb(255 255 255 / .25); background: rgb(255 255 255 / .08); }
  .ficha-icono .icono-caja { width: 8rem; height: 8rem; border-radius: 2rem; background: #fff; color: var(--c-primario); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.28rem; font-weight: 550; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; margin-bottom: 1rem; opacity: .7; }
  .ficha-datos { border: 1px solid var(--linea); border-radius: var(--radio); padding: 1.5rem; background: var(--suave); }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-precio-dato { font-family: var(--fuente-mono); }
  .ficha-cita { display: grid; gap: .9rem; border-radius: var(--radio); padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 850; letter-spacing: -0.03em; line-height: 1.1; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem; border-radius: var(--radio); border: 1px solid var(--linea); transition: background-color .2s ease; }
  .ficha-otra:hover { background: color-mix(in srgb, var(--c-fondo) 8%, transparent); }
  .ficha-otra h3 { font-size: 1.4rem; margin-top: .6rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; border-radius: var(--radio); }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra p { opacity: .75; }
  .ficha-otra-pie { margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .4rem; font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 700; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4.5rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
